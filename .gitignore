# ──────────────────────────────────────────────
# ModelForge — ML Experiment Tracking & Deployment
# .gitignore
# ──────────────────────────────────────────────

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual Environments ─────────────────────
venv/
env/
.venv/
.env/
auth/

# ── Distribution / Packaging ─────────────────
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── MLflow Tracking Data ─────────────────────
# mlruns/ contains large binary artifacts & experiment data.
# Exclude to keep repository lightweight; regenerate by running mlflow_demo.py
mlruns/
mlflow.db
mlartifacts/
latest_run_id.txt

# ── Model Binary Files ────────────────────────
# Large binary model files should be managed via MLflow or Git LFS.
# Uncomment the line below to also exclude model.pkl:
model.pkl
*.pkl
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.pb
*.joblib

# ── Jupyter Notebooks ─────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing & Coverage ────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── IDE & Editor Files ────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── OS Files ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets & Credentials ─────────────────────
.env
*.env
secrets.yaml
secrets.json

# ── Logs ──────────────────────────────────────
*.log
logs/

# ── Temporary Files ───────────────────────────
*.tmp
*.bak
*.orig
